        <span class="footer-brand">AO · Alan Orellana</span>
        <span>Front-End · UI/UX</span>
        <span>© 2026</span>
      </div>
    </footer>

    <script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const layers = document.querySelectorAll("[data-speed]");
  let ticking = false;

  function update() {
    const y = window.scrollY;
    const factor = window.innerWidth < 850 ? 0.5 : 1; // más suave en móvil
    if (y < window.innerHeight * 1.5) {
      layers.forEach((el) => {
        const speed = parseFloat(el.dataset.speed);
        el.style.transform = `translate3d(0, ${y * speed * factor}px, 0)`;
      });
    }
    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }

  if (!reduce.matches) {
    window.addEventListener("scroll", onScroll, { passive: true });
    update();
  }
</script>
  </body>
</html>
